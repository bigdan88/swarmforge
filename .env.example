# Copy to .env (next to swarmforge.yaml) and fill in. Never commit .env.
# These variables are read by the orchestrator process only; they are never passed into agent
# sandboxes, and command environments are scrubbed of anything named *KEY*/*TOKEN*/*SECRET*.

# DeepInfra API key (https://deepinfra.com/dash/api_keys)
DEEPINFRA_API_KEY=

# Fine-grained GitHub token limited to the target repository:
#   Contents: Read and write, Pull requests: Read and write, Issues: Read, Metadata: Read
# Optional: if unset, `gh auth token` is used when the GitHub CLI is logged in.
GITHUB_TOKEN=
