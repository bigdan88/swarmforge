# SwarmForge agent sandbox image.
# Built by `swarmforge sandbox build`. Contains Python + pytest; no credentials, no git remotes.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
RUN pip install --no-cache-dir "pytest>=8" "pytest-timeout>=2" \
 && useradd --create-home --uid 10001 agent
USER agent
WORKDIR /workspace
