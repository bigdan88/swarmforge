# SwarmForge agent sandbox image.
# Built by `swarmforge sandbox build`. Contains Python + pytest + the agents' developer tools
# (ruff, mypy, Playwright + headless Chromium, Node.js + Pi); no credentials, no git remotes.
# Build with --build-arg WITH_BROWSER=0 for a smaller image without the browser.
ARG BASE_IMAGE=python:3.12-slim
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS node
FROM ${BASE_IMAGE}
ARG WITH_BROWSER=1
ARG PI_VERSION=1.4.0
# Node.js + the Pi coding agent (pi.dev), used by roles with `runtime: pi`
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && npm install -g --ignore-scripts --no-audit --no-fund "@earendil-works/pi-coding-agent@${PI_VERSION}" \
# preflight self-checks these tools inside the image (swarmforge/preflight.py: SANDBOX_REQUIRED_TOOLS)
 && apt-get update && apt-get install -y --no-install-recommends ripgrep git curl && rm -rf /var/lib/apt/lists/* \
 && pi --version
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# preflight self-checks these tools inside the image (swarmforge/preflight.py: SANDBOX_REQUIRED_TOOLS)
RUN pip install --no-cache-dir "pytest>=8" "pytest-timeout>=2" "ruff>=0.6" "mypy>=1.11" \
 && if [ "$WITH_BROWSER" = "1" ]; then \
      pip install --no-cache-dir "playwright>=1.45" \
      && python -m playwright install --with-deps chromium \
      && chmod -R a+rX /ms-playwright \
      && rm -rf /var/lib/apt/lists/*; \
    fi \
 && useradd --create-home --uid 10001 agent
USER agent
WORKDIR /workspace
