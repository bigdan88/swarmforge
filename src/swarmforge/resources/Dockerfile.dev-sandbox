# Sandbox for running SwarmForge's OWN test suite (self-improvement runs).
# Built by `swarmforge sandbox build --dev` on top of the normal sandbox image.
ARG BASE=swarmforge-sandbox:latest
FROM ${BASE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir "httpx>=0.27" "PyYAML>=6.0" "pytest-asyncio>=0.23" "pytest-xdist>=3.5" "streamlit>=1.50" "pandas>=2.0" \
 && git config --system --add safe.directory '*' \
 && git config --system user.name "SwarmForge Sandbox" \
 && git config --system user.email "sandbox@localhost" \
 && git config --system init.defaultBranch main
USER agent
